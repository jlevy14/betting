# ------------------------------------------------------------------
# LETS MAKE A BILLION - environment variables
# Copy this file to ".env" and fill in real values.
# ------------------------------------------------------------------

# --- Supabase Postgres ---
# Get these from Supabase: Project -> Connect -> ORMs -> Prisma.
# Supabase shows you two ready-to-paste lines. Just copy them here.
#
# DATABASE_URL: the "Transaction" pooler (host has ...pooler..., port 6543).
#   Must include ?pgbouncer=true  (add &connection_limit=1 for serverless).
DATABASE_URL="postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: the "Session" pooler (same host, port 5432). Used for migrations.
DIRECT_URL="postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- App passwords ---
# Password everyone in the league types to submit a pick.
LEAGUE_PASSWORD="letsgo"

# Password only YOU (the commissioner) knows. Controls names + payout + overrides.
COMMISH_PASSWORD="changeme"
